# RayNeo GT AR glasses: let the logged-in user open the IMU's HID interface
# (hidraw) without root. VID:PID 3941:AF50, product "RayNeo AR Glasses",
# vendor-defined usage page 0xFF00 (docs/PROTOCOL-NOTES.md).
#
# uaccess grants the active seat's user an ACL; the plugdev group is the
# fallback for sessions without logind (ssh, headless test rigs).
#
# Install: sudo install -m 0644 70-rayneo-gt.rules /etc/udev/rules.d/
#          sudo udevadm control --reload && sudo udevadm trigger
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="3941", ATTRS{idProduct}=="af50", TAG+="uaccess", MODE="0660", GROUP="plugdev"
